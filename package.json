{
  "name": "meu-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "server": "node server.js",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "node ./scripts/run-vitest.mjs",
    "test:ui": "node ./scripts/run-vitest.mjs --ui",
    "test:run": "node ./scripts/run-vitest.mjs run",
    "test:coverage": "node ./scripts/run-vitest.mjs run --coverage",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,jsx,mjs,cjs}": "eslint",
    "*.{ts,tsx,vue,js,jsx,mjs,cjs,json,md,css}": "prettier --check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "axios": "^1.15.2",
    "i18n": "^0.15.3",
    "json-server": "^1.0.0-beta.15",
    "json-server-auth": "^2.1.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "uuid": "^14.0.0",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  }
}
